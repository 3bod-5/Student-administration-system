<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Messenger</title>
    <!-- Links to your shared stylesheet -->
    <link rel="stylesheet" href="/main.css">
</head>
<body>
    <%- include('../partials/staffNav') %>
    <div class="main-wrapper">
        
        <!-- Compose Message Module -->
        <div class="container">
            <h1>Send New Message</h1>
            
            <form action="/staff/send" method="POST">
                <div class="form-group">
                    <label for="recipient">Recipient's Username</label>
                    <input type="text" id="recipient" name="recipient" placeholder="Enter username..." required>
                </div>
                
                <div class="form-group">
                    <label for="message">Message Content</label>
                    <textarea id="message" name="message" rows="4" placeholder="Type your message details here..." required></textarea>
                </div>
                
                <button type="submit" class="btn-add btn-send">Send Message</button>
            </form>
        </div>
        
        <!-- Sent Messages Outbox Feed -->
        <div class="container">
            <h1>Sent Messages Log</h1>
            
            <% if (messages && messages.length > 0) { %>
                <ul class="message-list">
                    <% messages.forEach(message => { %>
                        <li class="message-item">
                            <div class="message-header">
                                <span class="message-sender"><span class="label-to">To:</span> <%= message.recipient %></span>
                                <span class="message-time"><%= message.timestamp %></span>
                            </div>
                            <div class="message-body sent-body">
                                <%= message.message %>
                            </div>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <div class="empty-state">
                    <p>No messages sent by you yet.</p>
                </div>
            <% } %>
        </div>

    </div>

</body>
</html>
