<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Students</title>
    <!-- Links to your shared stylesheet -->
    <link rel="stylesheet" href="/main.css">
</head>
<body>
    <%- include('../partials/staffNav') %>
    <div class="main-wrapper">
        
        <!-- Search Bar Form -->
        <div class="container">
            <h1>Search Students</h1>
            <form action="/staff/all-students" method="get" class="search-form">
                <div class="form-group search-group">
                    <label for="studentname" class="visually-hidden">Student name</label>
                    <input type="text" id="studentname" placeholder="Enter Student Name..." name="studentname" required>
                    <button type="submit" class="btn-search">Search</button>
                </div>
            </form>
        </div>
            
        <!-- Student Directory Records -->
        <div class="container"> 
            <h1>Student Directory</h1>
            
            <ul class="directory-list">
                <% for(let i = 0 ; i < users.length ; i++){ %> 
                    <li class="directory-item">
                        <div class="student-meta">
                            <span class="student-name"><%= users[i].name %></span>
                            <span class="student-dept"><%= users[i].department %></span>
                        </div>
                        <div class="directory-actions">
                            <!-- Update/Action option button -->
                            <button class="btn-action btn-update">Update</button>
                            <!-- Delete link styled perfectly as an inline secondary button -->
                            <a href="/delete-users/<%= users[i]._id %>" class="btn-action btn-delete-link">Delete</a> 
                        </div>
                    </li>
                <% } %>
            </ul>
        </div>

    </div>

</body>
</html>