<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Available Courses</title>
    <!-- Links to your shared stylesheet -->
    <link rel="stylesheet" href="/main.css">
</head>
<body>
    <%- include('../partials/studentNav') %>
    <div class="main-wrapper">
        
        <!-- Header Section -->
        <div class="page-header">
            <h1>Your Available subjects that you can enroll to</h1>
            <p class="subtitle-text">Overview of your list of subject to chose from</p>
        </div>

        <!-- Courses Dynamic Grid -->
        <div class="courses-grid">
            <% for(let i = 0 ; i < subjects.length ; i++){ %>
                <div class="course-card">
                    <div class="course-card-header">
                        <span class="course-badge-code"><%= subjects[i].code %></span>
                        <span class="course-badge-dept"><%= subjects[i].department %></span>
                    </div>
                    <h2 class="course-card-title"><%= subjects[i].name %></h2>
                </div>
            <% } %>
        </div>

    </div>

</body>
</html>