<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Add Course</title>
    <link rel="stylesheet" href="/main.css">
</head>
<body>
    <%- include('../partials/adminNav') %>
    <div class="main-wrapper">
        
        <div class="container">
            <h1>Create New Course</h1>
            
            <form action="/admin/add-course" method="post">
                
                <div class="form-group">
                    <label for="doctorname">Doctor Name</label>
                    <input type="text" id="doctorname" placeholder="Enter Instructor Name" name="doctorname" required>
                </div>
                
                <div class="form-group">
                    <label for="name">Course Name</label>
                    <input type="text" id="name" placeholder="Enter Course Name" name="name" required>
                </div>
                
                <div class="form-group">
                    <label for="code">Course Code</label>
                    <input type="text" id="code" placeholder="e.g., CS211" name="code" required>
                </div>
                
                <div class="form-group">
                    <label for="presubject">Prerequisite Subject</label>
                    <input type="text" id="presubject" placeholder="e.g., CS101 (or None)" name="presubject" required>
                </div>
                
                <div class="form-group">
                    <label for="year">Academic Year</label>
                    <input type="text" id="year" placeholder="e.g., 2026/2027" name="year" required>
                </div>
                
                <div class="radio-section">
                    <span class="radio-section-title">Semester</span>
                    <div class="radio-group">
                        <label class="radio-label">
                            <input type="radio" name="semester" value="semester1" required> Semester 1
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="semester" value="semester2" required> Semester 2
                        </label>
                    </div>
                </div>
                
                <div class="radio-section">
                    <span class="radio-section-title">Department Target</span>
                    <div class="radio-group flex-wrap">
                        <label class="radio-label"><input type="radio" name="department" value="IT" required> IT</label>
                        <label class="radio-label"><input type="radio" name="department" value="CS" required> CS</label>
                        <label class="radio-label"><input type="radio" name="department" value="IS" required> IS</label>
                        <label class="radio-label"><input type="radio" name="department" value="AI" required> AI</label>
                        <label class="radio-label"><input type="radio" name="department" value="All" required>ALL</label>
                    </div>
                </div>
                
                <div class="radio-section">
                    <span class="radio-section-title">Academic Level</span>
                    <div class="radio-group">
                        <label class="radio-label"><input type="radio" name="level" value="1" required> 1</label>
                        <label class="radio-label"><input type="radio" name="level" value="2" required> 2</label>
                        <label class="radio-label"><input type="radio" name="level" value="3" required> 3</label>
                        <label class="radio-label"><input type="radio" name="level" value="4" required> 4</label>
                    </div>
                </div>
                
                <button type="submit" class="btn-add btn-admin-submit">Add Course to Catalog</button>
            </form>
        </div>

    </div>

</body>
</html>